// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Liquidity Map (free) — estimated liquidation levels + swing stops.
// Same logic as btcf/liquidity.py in github.com/jallow101/btc-forecast, so the chart matches the website.
//@version=6
indicator("Liquidity Map (free)", shorttitle = "LiqMap", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 20, max_bars_back = 1100)

// ── Inputs ─────────────────────────────────────────────────────────────
grpL = "Leverage tiers (share of new positions)"
use10  = input.bool(true, "10x",  inline = "a", group = grpL)
use25  = input.bool(true, "25x",  inline = "a", group = grpL)
use50  = input.bool(true, "50x",  inline = "a", group = grpL)
use100 = input.bool(true, "100x", inline = "a", group = grpL)
mmr    = input.float(0.5, "Maintenance margin %", step = 0.1, group = grpL) / 100

grpE = "Engine"
volLen   = input.int(50, "Volume average length", group = grpE)
volMult  = input.float(1.5, "High-volume candle (x average)", step = 0.1, group = grpE)
pivLen   = input.int(5, "Swing pivot length", group = grpE)
halfLife = input.int(250, "Weight half-life (bars)", group = grpE)
maxAge   = input.int(1000, "Forget levels after (bars)", group = grpE)
lookback = input.int(3000, "Process last N bars", group = grpE)

grpD = "Display"
binPct    = input.float(0.25, "Bin size % of price", step = 0.05, group = grpD) / 100
rangePct  = input.float(8.0, "Show within ± %", step = 1.0, group = grpD) / 100
histW     = input.int(40, "Histogram width (bars)", group = grpD)
showLines = input.bool(true, "Draw strongest levels as lines", group = grpD)
nLines    = input.int(40, "How many lines", minval = 1, maxval = 400, group = grpD)
showLbl   = input.bool(true, "Label biggest cluster above / below", group = grpD)
colLiq    = input.color(color.new(#e08a69, 0), "Liquidation estimates", group = grpD)
colSw     = input.color(color.new(#7aa7da, 0), "Swing stops", group = grpD)

grpA = "Alerts"
grabThr = input.float(3.0, "Big grab = swept weight above", step = 0.5, group = grpA)

// ── State ──────────────────────────────────────────────────────────────
var lp = array.new<float>()   // level price
var lw = array.new<float>()   // base weight
var lb = array.new<int>()     // bar created
var la = array.new<bool>()    // true = above price (short liq / swing high)
var lk = array.new<bool>()    // true = liquidation estimate, false = swing stop

f_add(float p, float w, bool above, bool isLiq) =>
    array.push(lp, p)
    array.push(lw, w)
    array.push(lb, bar_index)
    array.push(la, above)
    array.push(lk, isLiq)

active = bar_index >= last_bar_index - lookback

// ── 1. Sweep: remove levels price traded through ───────────────────────
float sweptBelow = 0.0
float sweptAbove = 0.0
if active and array.size(lp) > 0
    for k = array.size(lp) - 1 to 0
        age = bar_index - array.get(lb, k)
        w = array.get(lw, k) * math.pow(0.5, float(age) / halfLife)
        isAbove = array.get(la, k)
        hit = isAbove ? high >= array.get(lp, k) : low <= array.get(lp, k)
        if hit
            if isAbove
                sweptAbove += w
            else
                sweptBelow += w
        if hit or age > maxAge
            array.remove(lp, k)
            array.remove(lw, k)
            array.remove(lb, k)
            array.remove(la, k)
            array.remove(lk, k)

// ── 2. Swing stops (confirmed pivots) ──────────────────────────────────
vavg = ta.sma(volume, volLen)[1]
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
if active
    relP = not na(vavg[pivLen]) and vavg[pivLen] > 0 ? volume[pivLen] / vavg[pivLen] : 1.0
    sw = math.max(1.0, relP)
    if not na(ph)
        f_add(ph, sw, true, false)
    if not na(pl)
        f_add(pl, sw, false, false)

// ── 3. Liquidation estimates from high-volume candles ──────────────────
    if not na(vavg) and vavg > 0
        rel = volume / vavg
        if rel > volMult
            if use10
                f_add(close * (1 - 1.0 / 10 + mmr), rel * 0.30, false, true)
                f_add(close * (1 + 1.0 / 10 - mmr), rel * 0.30, true, true)
            if use25
                f_add(close * (1 - 1.0 / 25 + mmr), rel * 0.30, false, true)
                f_add(close * (1 + 1.0 / 25 - mmr), rel * 0.30, true, true)
            if use50
                f_add(close * (1 - 1.0 / 50 + mmr), rel * 0.25, false, true)
                f_add(close * (1 + 1.0 / 50 - mmr), rel * 0.25, true, true)
            if use100
                f_add(close * (1 - 1.0 / 100 + mmr), rel * 0.15, false, true)
                f_add(close * (1 + 1.0 / 100 - mmr), rel * 0.15, true, true)

// ── 4. Draw on the last bar ────────────────────────────────────────────
var boxes = array.new<box>()
var lines = array.new<line>()
var labels = array.new<label>()

if barstate.islast
    for b in boxes
        box.delete(b)
    array.clear(boxes)
    for l in lines
        line.delete(l)
    array.clear(lines)
    for t in labels
        label.delete(t)
    array.clear(labels)

    step = close * binPct
    half = int(math.ceil(rangePct / binPct))
    nb = 2 * half
    wl = array.new<float>(nb, 0.0)
    ws = array.new<float>(nb, 0.0)
    n = array.size(lp)
    cur = array.new<float>(n, 0.0)
    if n > 0
        for k = 0 to n - 1
            p = array.get(lp, k)
            w = array.get(lw, k) * math.pow(0.5, float(bar_index - array.get(lb, k)) / halfLife)
            array.set(cur, k, w)
            idx = int(math.floor((p - close) / step)) + half
            if idx >= 0 and idx < nb
                if array.get(lk, k)
                    array.set(wl, idx, array.get(wl, idx) + w)
                else
                    array.set(ws, idx, array.get(ws, idx) + w)
    wmax = 0.0
    for i = 0 to nb - 1
        wmax := math.max(wmax, array.get(wl, i) + array.get(ws, i))
    bestUp = -1
    bestDn = -1
    for i = 0 to nb - 1
        tot = array.get(wl, i) + array.get(ws, i)
        if tot > 0 and wmax > 0
            lo = close + (i - half) * step
            x0 = bar_index + 2
            xl = x0 + int(math.round(array.get(wl, i) / wmax * histW))
            xs = xl + int(math.round(array.get(ws, i) / wmax * histW))
            tr = int(85 - 75 * math.sqrt(tot / wmax))
            if xl > x0
                array.push(boxes, box.new(x0, lo + step, xl, lo, border_color = color(na), bgcolor = color.new(colLiq, tr)))
            if xs > xl
                array.push(boxes, box.new(xl, lo + step, xs, lo, border_color = color(na), bgcolor = color.new(colSw, tr)))
            mid = lo + step / 2
            if math.abs(mid / close - 1) >= binPct * 2
                if mid > close and (bestUp < 0 or tot > array.get(wl, bestUp) + array.get(ws, bestUp))
                    bestUp := i
                if mid < close and (bestDn < 0 or tot > array.get(wl, bestDn) + array.get(ws, bestDn))
                    bestDn := i

    if showLines and n > 0
        ord = array.sort_indices(cur, order.descending)
        cnt = 0
        wtop = array.get(cur, array.get(ord, 0))
        for j = 0 to n - 1
            k = array.get(ord, j)
            p = array.get(lp, k)
            if math.abs(p / close - 1) <= rangePct and cnt < nLines
                tr = int(90 - 70 * math.sqrt(array.get(cur, k) / wtop))
                c = array.get(lk, k) ? colLiq : colSw
                array.push(lines, line.new(array.get(lb, k), p, bar_index + 1, p, color = color.new(c, tr), width = 1))
                cnt += 1

    if showLbl
        if bestUp >= 0
            pu = close + (bestUp - half + 0.5) * step
            array.push(labels, label.new(bar_index + histW + 4, pu, "▲ " + str.tostring(pu, format.mintick) + "  (+" + str.tostring((pu / close - 1) * 100, "#.##") + "%)", style = label.style_label_left, color = color.new(colLiq, 20), textcolor = color.white, size = size.small))
        if bestDn >= 0
            pd = close + (bestDn - half + 0.5) * step
            array.push(labels, label.new(bar_index + histW + 4, pd, "▼ " + str.tostring(pd, format.mintick) + "  (" + str.tostring((pd / close - 1) * 100, "#.##") + "%)", style = label.style_label_left, color = color.new(colLiq, 20), textcolor = color.white, size = size.small))

// ── Alerts and markers ─────────────────────────────────────────────────
grabBelow = sweptBelow >= grabThr and close > low + (high - low) * 0.5
grabAbove = sweptAbove >= grabThr and close < high - (high - low) * 0.5
plotshape(grabBelow, "Liquidity grab below", shape.triangleup, location.belowbar, color.new(#2f7d4f, 0), size = size.tiny)
plotshape(grabAbove, "Liquidity grab above", shape.triangledown, location.abovebar, color.new(#b3412e, 0), size = size.tiny)
alertcondition(grabBelow, "Liquidity grab below", "{{ticker}}: big liquidity sweep below and close back up at {{close}}")
alertcondition(grabAbove, "Liquidity grab above", "{{ticker}}: big liquidity sweep above and close back down at {{close}}")
